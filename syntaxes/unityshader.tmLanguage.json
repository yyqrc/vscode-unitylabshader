{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Unity Shader",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#shaderlab"
    },
    {
      "include": "#cgprogram-block"
    },
    {
      "include": "#hlslprogram-block"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#operator"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numerics"
    },
    {
      "include": "#hlsl-keywords"
    },
    {
      "include": "#hlsl-types"
    },
    {
      "include": "#hlsl-functions"
    },
    {
      "include": "#unity-macros"
    },
    {
      "include": "#semantics"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "begin": "//",
          "end": "$",
          "name": "comment.line.double-slash.unityshader"
        },
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.unityshader"
        }
      ]
    },
    "shaderlab": {
      "patterns": [
        {
          "comment": "ShaderLab Shader declaration",
          "match": "\\b(Shader)\\b",
          "name": "keyword.declaration.shader.unityshader"
        },
        {
          "comment": "ShaderLab structure keywords",
          "match": "\\b(Properties|SubShader|Pass|Category|LOD|FallBack|CustomEditor|UsePass|GrabPass|Name)\\b",
          "name": "keyword.structure.shaderlab.unityshader"
        },
        {
          "comment": "ShaderLab property types",
          "match": "\\b(2D|3D|Cube|CubeArray|2DArray|Color|Vector|Float|Int|Integer|Range)\\b",
          "name": "storage.type.property.shaderlab.unityshader"
        },
        {
          "comment": "ShaderLab render state keywords",
          "match": "\\b(Blend|BlendOp|AlphaToMask|ColorMask|Cull|ZWrite|ZTest|ZClip|Offset|Stencil|Comp|Pass|Fail|ZFail|ReadMask|WriteMask|Ref)\\b",
          "name": "keyword.renderstate.shaderlab.unityshader"
        },
        {
          "comment": "ShaderLab blend modes",
          "match": "\\b(One|Zero|SrcColor|SrcAlpha|DstColor|DstAlpha|OneMinusSrcColor|OneMinusSrcAlpha|OneMinusDstColor|OneMinusDstAlpha)\\b",
          "name": "constant.language.blendmode.unityshader"
        },
        {
          "comment": "ShaderLab blend operations",
          "match": "\\b(Add|Sub|RevSub|Min|Max)\\b",
          "name": "constant.language.blendop.unityshader"
        },
        {
          "comment": "ShaderLab cull modes",
          "match": "\\b(Back|Front|Off)\\b",
          "name": "constant.language.cullmode.unityshader"
        },
        {
          "comment": "ShaderLab comparison functions",
          "match": "\\b(Less|Greater|LEqual|GEqual|Equal|NotEqual|Always|Never)\\b",
          "name": "constant.language.comparison.unityshader"
        },
        {
          "comment": "ShaderLab Tags block",
          "match": "\\b(Tags)\\b",
          "name": "keyword.tags.shaderlab.unityshader"
        },
        {
          "comment": "ShaderLab tag keys",
          "match": "\"(RenderType|Queue|LightMode|RenderPipeline|DisableBatching|ForceNoShadowCasting|IgnoreProjector|CanUseSpriteAtlas|PreviewType)\"",
          "name": "string.tag.key.shaderlab.unityshader"
        },
        {
          "comment": "ShaderLab other keywords",
          "match": "\\b(Lighting|Material|SetTexture|Fog|AlphaTest|BindChannels|Bind)\\b",
          "name": "keyword.other.shaderlab.unityshader"
        },
        {
          "comment": "ShaderLab legacy texture combiners",
          "match": "\\b(combine|constantColor|matrix|previous|primary|texture|constant|Double|Quad)\\b",
          "name": "keyword.legacy.shaderlab.unityshader"
        }
      ]
    },
    "cgprogram-block": {
      "begin": "\\b(CGPROGRAM|CGINCLUDE)\\b",
      "end": "\\b(ENDCG)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.structure.shaderlab.unityshader" }
      },
      "endCaptures": {
        "1": { "name": "keyword.structure.shaderlab.unityshader" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#preprocessor" },
        { "include": "#strings" },
        { "include": "#numerics" },
        { "include": "#operator" },
        { "include": "#hlsl-keywords" },
        { "include": "#hlsl-types" },
        { "include": "#hlsl-functions" },
        { "include": "#unity-macros" },
        { "include": "#semantics" }
      ]
    },
    "hlslprogram-block": {
      "begin": "\\b(HLSLPROGRAM|HLSLINCLUDE)\\b",
      "end": "\\b(ENDHLSL)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.structure.shaderlab.unityshader" }
      },
      "endCaptures": {
        "1": { "name": "keyword.structure.shaderlab.unityshader" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#preprocessor" },
        { "include": "#strings" },
        { "include": "#numerics" },
        { "include": "#operator" },
        { "include": "#hlsl-keywords" },
        { "include": "#hlsl-types" },
        { "include": "#hlsl-functions" },
        { "include": "#unity-macros" },
        { "include": "#semantics" }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.unityshader",
          "begin": "^\\s*(#)\\s*",
          "end": "$",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.directive.unityshader" }
          },
          "patterns": [
            {
              "match": "\\b(define|elif|else|endif|error|if|ifdef|ifndef|include|line|pragma|undef|warning)\\b",
              "name": "keyword.preprocessor.unityshader"
            },
            {
              "match": "\\b(vertex|fragment|geometry|hull|domain|surface|target|multi_compile|multi_compile_local|shader_feature|shader_feature_local|require|enable_d3d11_debug_symbols|skip_variants|only_renderers|exclude_renderers|instancing_options)\\b",
              "name": "keyword.pragma.unityshader"
            },
            { "include": "#strings" },
            { "include": "#numerics" }
          ]
        }
      ]
    },
    "hlsl-keywords": {
      "patterns": [
        {
          "comment": "Control flow keywords",
          "match": "\\b(break|case|continue|default|discard|do|else|for|if|return|switch|while)\\b",
          "name": "keyword.control.unityshader"
        },
        {
          "comment": "Storage modifiers",
          "match": "\\b(const|extern|inline|inout|in|out|static|uniform|volatile|groupshared|nointerpolation|centroid|linear|noperspective|sample|globallycoherent|precise)\\b",
          "name": "storage.modifier.unityshader"
        },
        {
          "comment": "Shader stage keywords",
          "match": "\\b(cbuffer|tbuffer|ConstantBuffer|StructuredBuffer|RWStructuredBuffer|ByteAddressBuffer|RWByteAddressBuffer|Buffer|RWBuffer|AppendStructuredBuffer|ConsumeStructuredBuffer)\\b",
          "name": "storage.type.buffer.unityshader"
        },
        {
          "comment": "Unroll and branch attributes",
          "match": "\\b(UNROLL|LOOP|FLATTEN|BRANCH|unroll|loop|flatten|branch)\\b",
          "name": "keyword.attribute.unityshader"
        },
        {
          "comment": "Struct and typedef",
          "match": "\\b(struct|typedef|class|interface)\\b",
          "name": "storage.type.struct.unityshader"
        }
      ]
    },
    "hlsl-types": {
      "patterns": [
        {
          "comment": "Basic scalar types",
          "match": "\\b(bool|int|uint|dword|half|float|double|fixed|void|string)\\b",
          "name": "storage.type.scalar.unityshader"
        },
        {
          "comment": "Vector types",
          "match": "\\b(bool[1-4]|int[1-4]|uint[1-4]|half[1-4]|float[1-4]|double[1-4]|fixed[1-4]|min16float[1-4]|min10float[1-4]|min16int[1-4]|min12int[1-4]|min16uint[1-4])\\b",
          "name": "storage.type.vector.unityshader"
        },
        {
          "comment": "Matrix types",
          "match": "\\b(float[1-4]x[1-4]|half[1-4]x[1-4]|double[1-4]x[1-4]|int[1-4]x[1-4]|uint[1-4]x[1-4]|bool[1-4]x[1-4]|fixed[1-4]x[1-4])\\b",
          "name": "storage.type.matrix.unityshader"
        },
        {
          "comment": "Sampler types",
          "match": "\\b(sampler|sampler1D|sampler2D|sampler3D|samplerCUBE|sampler_state|SamplerState|SamplerComparisonState)\\b",
          "name": "storage.type.sampler.unityshader"
        },
        {
          "comment": "Texture types",
          "match": "\\b(texture|Texture1D|Texture1DArray|Texture2D|Texture2DArray|Texture2DMS|Texture2DMSArray|Texture3D|TextureCube|TextureCubeArray|RWTexture1D|RWTexture1DArray|RWTexture2D|RWTexture2DArray|RWTexture3D)\\b",
          "name": "storage.type.texture.unityshader"
        }
      ]
    },
    "hlsl-functions": {
      "patterns": [
        {
          "comment": "HLSL intrinsic functions",
          "match": "\\b(abs|acos|all|AllMemoryBarrier|AllMemoryBarrierWithGroupSync|any|asdouble|asfloat|asin|asint|asuint|atan|atan2|ceil|clamp|clip|cos|cosh|countbits|cross|D3DCOLORtoUBYTE4|ddx|ddx_coarse|ddx_fine|ddy|ddy_coarse|ddy_fine|degrees|determinant|DeviceMemoryBarrier|DeviceMemoryBarrierWithGroupSync|distance|dot|dst|EvaluateAttributeAtCentroid|EvaluateAttributeAtSample|EvaluateAttributeSnapped|exp|exp2|f16tof32|f32tof16|faceforward|firstbithigh|firstbitlow|floor|fma|fmod|frac|frexp|fwidth|GetRenderTargetSampleCount|GetRenderTargetSamplePosition|GroupMemoryBarrier|GroupMemoryBarrierWithGroupSync|InterlockedAdd|InterlockedAnd|InterlockedCompareExchange|InterlockedCompareStore|InterlockedExchange|InterlockedMax|InterlockedMin|InterlockedOr|InterlockedXor|isfinite|isinf|isnan|ldexp|length|lerp|lit|log|log10|log2|mad|max|min|modf|msad4|mul|noise|normalize|pow|radians|rcp|reflect|refract|reversebits|round|rsqrt|saturate|sign|sin|sincos|sinh|smoothstep|sqrt|step|tan|tanh|transpose|trunc)\\b",
          "name": "support.function.intrinsic.unityshader"
        },
        {
          "comment": "Texture sampling functions",
          "match": "\\b(tex1D|tex1Dbias|tex1Dgrad|tex1Dlod|tex1Dproj|tex2D|tex2Dbias|tex2Dgrad|tex2Dlod|tex2Dproj|tex3D|tex3Dbias|tex3Dgrad|tex3Dlod|tex3Dproj|texCUBE|texCUBEbias|texCUBEgrad|texCUBElod|texCUBEproj|Sample|SampleBias|SampleCmp|SampleCmpLevelZero|SampleGrad|SampleLevel|Load|Gather|GatherRed|GatherGreen|GatherBlue|GatherAlpha)\\b",
          "name": "support.function.texture.unityshader"
        },
        {
          "comment": "Generic function call",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.unityshader" }
          }
        }
      ]
    },
    "unity-macros": {
      "patterns": [
        {
          "comment": "Unity transformation macros",
          "match": "\\b(UNITY_MATRIX_MVP|UNITY_MATRIX_MV|UNITY_MATRIX_V|UNITY_MATRIX_P|UNITY_MATRIX_VP|UNITY_MATRIX_T_MV|UNITY_MATRIX_IT_MV|UNITY_MATRIX_M|UNITY_MATRIX_I_M|UNITY_MATRIX_I_V|unity_ObjectToWorld|unity_WorldToObject|unity_MatrixVP|unity_MatrixV|unity_MatrixInvV)\\b",
          "name": "constant.language.matrix.unity.unityshader"
        },
        {
          "comment": "Unity built-in variables",
          "match": "\\b(_WorldSpaceCameraPos|_ProjectionParams|_ScreenParams|_ZBufferParams|unity_OrthoParams|unity_CameraProjection|unity_CameraInvProjection|unity_CameraWorldClipPlanes|_Time|_SinTime|_CosTime|unity_DeltaTime|_WorldSpaceLightPos0|_LightPositionRange|_LightColor0|unity_4LightPosX0|unity_4LightPosY0|unity_4LightPosZ0|unity_4LightAtten0|unity_LightColor|unity_WorldToShadow|_LightShadowData|unity_ShadowFadeCenterAndType|unity_AmbientSky|unity_AmbientEquator|unity_AmbientGround|UNITY_LIGHTMODEL_AMBIENT|unity_FogColor|unity_FogParams)\\b",
          "name": "constant.language.builtin.unity.unityshader"
        },
        {
          "comment": "Unity common macros and functions",
          "match": "\\b(UnityObjectToClipPos|UnityObjectToViewPos|UnityWorldToClipPos|UnityViewToClipPos|UnityObjectToWorldNormal|UnityObjectToWorldDir|UnityWorldToObjectDir|UnityWorldSpaceViewDir|UnityWorldSpaceLightDir|ComputeScreenPos|ComputeGrabScreenPos|TRANSFORM_TEX|UNITY_TRANSFER_FOG|UNITY_APPLY_FOG|UNITY_FOG_COORDS|SHADOW_COORDS|TRANSFER_SHADOW|SHADOW_ATTENUATION|UNITY_SHADOW_COORDS|UNITY_TRANSFER_SHADOW|UNITY_SHADOW_ATTENUATION|UNITY_LIGHT_ATTENUATION|COMPUTE_EYEDEPTH|DECODE_EYEDEPTH|LinearEyeDepth|Linear01Depth|DecodeFloatRG|EncodeFloatRG|DecodeFloatRGBA|EncodeFloatRGBA|DecodeHDR|EncodeHDR|GammaToLinearSpace|LinearToGammaSpace|UnpackNormal|UnpackNormalWithScale|Shade4PointLights|ShadeSH9|ShadeSH3Order|ShadeVertexLights)\\b",
          "name": "support.function.unity.unityshader"
        },
        {
          "comment": "Unity instance macros",
          "match": "\\b(UNITY_VERTEX_INPUT_INSTANCE_ID|UNITY_VERTEX_OUTPUT_STEREO|UNITY_SETUP_INSTANCE_ID|UNITY_TRANSFER_INSTANCE_ID|UNITY_SETUP_STEREO_EYE_INDEX_POST_VERTEX|UNITY_INITIALIZE_OUTPUT|UNITY_INITIALIZE_VERTEX_OUTPUT_STEREO)\\b",
          "name": "support.function.macro.unity.unityshader"
        },
        {
          "comment": "Unity texture macros",
          "match": "\\b(SAMPLE_TEXTURE2D|SAMPLE_TEXTURE2D_LOD|SAMPLE_TEXTURE2D_BIAS|SAMPLE_TEXTURE2D_GRAD|SAMPLE_TEXTURE2D_ARRAY|SAMPLE_TEXTURE2D_ARRAY_LOD|SAMPLE_TEXTURECUBE|SAMPLE_TEXTURECUBE_LOD|SAMPLE_TEXTURE3D|SAMPLE_TEXTURE3D_LOD|LOAD_TEXTURE2D|LOAD_TEXTURE2D_LOD|LOAD_TEXTURE2D_MSAA|GATHER_TEXTURE2D|GATHER_RED_TEXTURE2D|GATHER_GREEN_TEXTURE2D|GATHER_BLUE_TEXTURE2D|GATHER_ALPHA_TEXTURE2D)\\b",
          "name": "support.function.texture.unity.unityshader"
        },
        {
          "comment": "Unity texture declaration macros",
          "match": "\\b(UNITY_DECLARE_TEX2D|UNITY_DECLARE_TEX2D_NOSAMPLER|UNITY_DECLARE_TEX2DARRAY|UNITY_DECLARE_TEXCUBE|UNITY_DECLARE_TEXCUBEARRAY|UNITY_DECLARE_TEX3D|UNITY_SAMPLE_TEX2D|UNITY_SAMPLE_TEX2D_SAMPLER|UNITY_SAMPLE_TEX2DARRAY|UNITY_SAMPLE_TEX2DARRAY_LOD|UNITY_SAMPLE_TEXCUBE|UNITY_SAMPLE_TEXCUBE_LOD|UNITY_SAMPLE_TEXCUBEARRAY|UNITY_SAMPLE_TEX3D|UNITY_SAMPLE_TEX3D_LOD)\\b",
          "name": "support.function.texture.declaration.unity.unityshader"
        }
      ]
    },
    "semantics": {
      "patterns": [
        {
          "comment": "Shader semantics",
          "match": ":\\s*(POSITION|SV_POSITION|SV_Target[0-7]?|SV_Depth|SV_VertexID|SV_InstanceID|SV_PrimitiveID|SV_IsFrontFace|SV_SampleIndex|SV_Coverage|SV_ClipDistance[0-7]?|SV_CullDistance[0-7]?|SV_DispatchThreadID|SV_GroupID|SV_GroupIndex|SV_GroupThreadID|COLOR[0-9]?|TEXCOORD[0-9]?|NORMAL|TANGENT|BINORMAL|BLENDWEIGHT[0-9]?|BLENDINDICES[0-9]?|PSIZE|VPOS|VFACE|DEPTH)\\b",
          "captures": {
            "1": { "name": "support.variable.semantic.unityshader" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.unityshader",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.unityshader",
          "match": "\\\\."
        }
      ]
    },
    "numerics": {
      "patterns": [
        {
          "comment": "Hexadecimal numbers",
          "match": "\\b0[xX][0-9a-fA-F]+[uUlL]*\\b",
          "name": "constant.numeric.hex.unityshader"
        },
        {
          "comment": "Float numbers with suffix",
          "match": "\\b[0-9]+\\.[0-9]*([eE][+-]?[0-9]+)?[fFhH]?\\b|\\b[0-9]*\\.[0-9]+([eE][+-]?[0-9]+)?[fFhH]?\\b|\\b[0-9]+[eE][+-]?[0-9]+[fFhH]?\\b",
          "name": "constant.numeric.float.unityshader"
        },
        {
          "comment": "Integer numbers",
          "match": "\\b[0-9]+[uUlL]*\\b",
          "name": "constant.numeric.integer.unityshader"
        }
      ]
    },
    "operator": {
      "patterns": [
        {
          "match": "(\\+\\+|\\-\\-)",
          "name": "keyword.operator.increment-decrement.unityshader"
        },
        {
          "match": "(\\+|\\-|\\*|\\%|\\/|<<|>>|&|\\^|\\|)?=",
          "name": "keyword.operator.assignment.unityshader"
        },
        {
          "match": "(!|&&|\\|\\|)",
          "name": "keyword.operator.logical.unityshader"
        },
        {
          "match": "((=|!)=|(<|>)=?)",
          "name": "keyword.operator.comparison.unityshader"
        },
        {
          "match": "(\\+|\\-|\\*|\\/|\\%)",
          "name": "keyword.operator.arithmetic.unityshader"
        },
        {
          "match": "(~|&|\\||\\^|<<|>>)",
          "name": "keyword.operator.bitwise.unityshader"
        },
        {
          "match": "(\\?|:)",
          "name": "keyword.operator.ternary.unityshader"
        }
      ]
    }
  },
  "scopeName": "source.unityshader"
}