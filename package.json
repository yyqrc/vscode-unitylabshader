{
  "name": "UnityShader",
  "displayName": "Unity Shader",
  "description": "%extension.description%",
  "version": "1.1.4",
  "publisher": "ashiqi",
  "author": {
    "name": "阿十七 & CodeBuddy"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.87.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "icon": "icon.png",
  "keywords": [
    "unity",
    "unreal",
    "shader",
    "shaderlab",
    "hlsl",
    "cg",
    "cginc",
    "compute shader",
    "usf",
    "ush",
    "urp",
    "universal render pipeline",
    "syntax highlighting",
    "intellisense",
    "code completion",
    "hover",
    "definition",
    "references",
    "rename",
    "mobile optimization",
    "shader analysis"
  ],
  "bugs": {
    "url": "https://github.com/yyqrc/vscode-unitylabshader/issues"
  },
  "homepage": "https://github.com/yyqrc/vscode-unitylabshader/blob/master/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/yyqrc/vscode-unitylabshader.git"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "unityshader",
        "aliases": [
          "Unity/Unreal Shader",
          "ShaderLab",
          "unityshader"
        ],
        "extensions": [
          ".shader",
          ".cginc",
          ".hlsl",
          ".hlsli",
          ".compute",
          ".cg",
          ".usf",
          ".ush"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "unityshader",
        "scopeName": "source.unityshader",
        "path": "./syntaxes/unityshader.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "type": "object",
      "properties": {
        "unityshader.suggest.basic": {
          "type": "boolean",
          "default": true,
          "description": "%unityshader.suggest.basic.description%"
        },
        "unityshader.suggest.unity": {
          "type": "boolean",
          "default": true,
          "description": "%unityshader.suggest.unity.description%"
        },
        "unityshader.suggest.urp": {
          "type": "boolean",
          "default": true,
          "description": "%unityshader.suggest.urp.description%"
        },
        "unityshader.engineType": {
          "type": "string",
          "enum": [
            "auto",
            "unity",
            "unreal"
          ],
          "default": "auto",
          "description": "%unityshader.engineType.description%"
        },
        "unityshader.analysis.semanticAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "%unityshader.analysis.semanticAnalysis.description%"
        },
        "unityshader.analysis.variantAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "%unityshader.analysis.variantAnalysis.description%"
        },
        "unityshader.analysis.maxVariantsWarning": {
          "type": "number",
          "default": 256,
          "description": "%unityshader.analysis.maxVariantsWarning.description%"
        },
        "unityshader.analysis.maxVariantsError": {
          "type": "number",
          "default": 512,
          "description": "%unityshader.analysis.maxVariantsError.description%"
        },
        "unityshader.files.useGitignore": {
          "type": "boolean",
          "default": true,
          "description": "%unityshader.files.useGitignore.description%"
        },
        "unityshader.mobile.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%unityshader.mobile.enabled.description%"
        },
        "unityshader.mobile.checkUnsupportedFeatures": {
          "type": "boolean",
          "default": true,
          "description": "%unityshader.mobile.checkUnsupportedFeatures.description%"
        },
        "unityshader.mobile.suggestHalfPrecision": {
          "type": "boolean",
          "default": true,
          "description": "%unityshader.mobile.suggestHalfPrecision.description%"
        },
        "unityshader.mobile.checkTextureOptimization": {
          "type": "boolean",
          "default": true,
          "description": "%unityshader.mobile.checkTextureOptimization.description%"
        },
        "unityshader.mobile.checkDiscouragedFunctions": {
          "type": "boolean",
          "default": true,
          "description": "%unityshader.mobile.checkDiscouragedFunctions.description%"
        },
        "unityshader.mobile.calculateComplexity": {
          "type": "boolean",
          "default": true,
          "description": "%unityshader.mobile.calculateComplexity.description%"
        },
        "unityshader.mobile.targetPlatform": {
          "type": "string",
          "enum": [
            "ES3.0",
            "ES3.1",
            "Metal",
            "Vulkan"
          ],
          "default": "ES3.0",
          "description": "%unityshader.mobile.targetPlatform.description%"
        }
      }
    },
    "commands": [
      {
        "command": "unityshader.switchEngine",
        "title": "%unityshader.switchEngine.title%"
      },
      {
        "command": "unityshader.buildSymbolCache",
        "title": "%unityshader.buildSymbolCache.title%"
      },
      {
        "command": "unityshader.clearSymbolCache",
        "title": "%unityshader.clearSymbolCache.title%"
      },
      {
        "command": "unityshader.showMobileOptimizationTips",
        "title": "%unityshader.showMobileOptimizationTips.title%"
      },
      {
        "command": "unityshader.toggleMobileAnalysis",
        "title": "%unityshader.toggleMobileAnalysis.title%"
      }
    ],
    "snippets": [
      {
        "language": "unityshader",
        "path": "%snippets.path%"
      }
    ],
    "keybindings": [
      {
        "command": "editor.action.formatDocument",
        "key": "shift+alt+f",
        "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorHasSelection && !editorReadonly && !inCompositeEditor"
      },
      {
        "command": "editor.action.formatSelection",
        "key": "shift+alt+f",
        "when": "editorHasDocumentFormattingProvider && editorHasSelection && editorTextFocus && !editorReadonly"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run l10n:check && npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "build": "node scripts/build-and-package.js patch",
    "build:minor": "node scripts/build-and-package.js minor",
    "build:major": "node scripts/build-and-package.js major",
    "version:bump": "node scripts/bump-version.js",
    "l10n:export": "vscode-l10n-dev export --outDir ./l10n ./src",
    "l10n:check": "node scripts/check-localization.js",
    "l10n:pseudo": "node scripts/generate-pseudo-localization.js",
    "test:l10n": "node scripts/test-localization.js"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.87.0",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.27.2",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.15.9"
  },
  "l10n": "./l10n"
}
