{
  "name": "UnityShader",
  "displayName": "Unity Shader",
  "description": "Unity and Unreal Shader language support for VS Code - syntax highlighting, code completion, hover tips and more for .shader, .cginc, .hlsl, .compute, .usf, .ush files",
  "version": "1.0.8",
  "publisher": "ashiqi",
  "author": {
    "name": "阿十七 & CodeBuddy"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.87.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "icon": "icon.png",
  "keywords": [
    "unity",
    "unreal",
    "shader",
    "shaderlab",
    "hlsl",
    "cg",
    "cginc",
    "compute shader",
    "usf",
    "ush",
    "urp",
    "universal render pipeline",
    "syntax highlighting",
    "intellisense",
    "code completion",
    "hover",
    "definition",
    "references",
    "rename",
    "mobile optimization",
    "shader analysis"
  ],
  "bugs": {
    "url": "https://github.com/yyqrc/vscode-unityshader/issues"
  },
  "homepage": "https://github.com/yyqrc/vscode-unityshader/blob/master/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/yyqrc/vscode-unityshader.git"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "unityshader",
        "aliases": [
          "Unity/Unreal Shader",
          "ShaderLab",
          "unityshader"
        ],
        "extensions": [
          ".shader",
          ".cginc",
          ".hlsl",
          ".hlsli",
          ".compute",
          ".cg",
          ".usf",
          ".ush"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "unityshader",
        "scopeName": "source.unityshader",
        "path": "./syntaxes/unityshader.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Unity Shader Configuration",
      "type": "object",
      "properties": {
        "unityshader.suggest.basic": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable basic HLSL language suggestions."
        },
        "unityshader.suggest.unity": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable Unity built-in variables and functions suggestions."
        },
        "unityshader.suggest.urp": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable URP (Universal Render Pipeline) suggestions."
        },
        "unityshader.engineType": {
          "type": "string",
          "enum": [
            "auto",
            "unity",
            "unreal"
          ],
          "default": "auto",
          "description": "Shader engine type: auto (auto-detect), unity (Unity Engine), unreal (Unreal Engine)."
        },
        "unityshader.analysis.semanticAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable semantic analysis (variable type inference, unused variable detection)."
        },
        "unityshader.analysis.variantAnalysis": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable shader variant analysis."
        },
        "unityshader.analysis.maxVariantsWarning": {
          "type": "number",
          "default": 256,
          "description": "Maximum number of shader variants before showing a warning."
        },
        "unityshader.analysis.maxVariantsError": {
          "type": "number",
          "default": 512,
          "description": "Maximum number of shader variants before showing an error."
        },
        "unityshader.mobile.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable/disable mobile platform optimization analysis. | 启用/禁用移动平台优化分析。"
        },
        "unityshader.mobile.checkUnsupportedFeatures": {
          "type": "boolean",
          "default": true,
          "description": "Check for features not supported on mobile platforms. | 检测移动平台不支持的特性。"
        },
        "unityshader.mobile.suggestHalfPrecision": {
          "type": "boolean",
          "default": true,
          "description": "Suggest using half precision for better mobile performance. | 建议使用 half 精度以提升移动端性能。"
        },
        "unityshader.mobile.checkTextureOptimization": {
          "type": "boolean",
          "default": true,
          "description": "Check for texture sampling optimizations. | 检测纹理采样优化建议。"
        },
        "unityshader.mobile.checkDiscouragedFunctions": {
          "type": "boolean",
          "default": true,
          "description": "Check for functions discouraged on mobile platforms. | 检测移动端不推荐使用的函数。"
        },
        "unityshader.mobile.calculateComplexity": {
          "type": "boolean",
          "default": true,
          "description": "Calculate and display shader complexity score. | 计算并显示 Shader 复杂度评分。"
        },
        "unityshader.mobile.targetPlatform": {
          "type": "string",
          "enum": [
            "ES3.0",
            "ES3.1",
            "Metal",
            "Vulkan"
          ],
          "default": "ES3.0",
          "description": "Target mobile platform for compatibility checking. | 目标移动平台（用于兼容性检测）。"
        }
      }
    },
    "commands": [
      {
        "command": "unityshader.switchEngine",
        "title": "Unity Shader: Switch Engine Type"
      },
      {
        "command": "unityshader.buildSymbolCache",
        "title": "Unity Shader: Build Symbol Cache"
      },
      {
        "command": "unityshader.clearSymbolCache",
        "title": "Unity Shader: Clear Symbol Cache"
      },
      {
        "command": "unityshader.showMobileOptimizationTips",
        "title": "Unity Shader: Show Mobile Optimization Tips"
      },
      {
        "command": "unityshader.toggleMobileAnalysis",
        "title": "Unity Shader: Toggle Mobile Analysis"
      }
    ],
    "snippets": [
      {
        "language": "unityshader",
        "path": "./snippets/unityshader.json"
      }
    ],
    "keybindings": [
      {
        "command": "editor.action.formatDocument",
        "key": "shift+alt+f",
        "when": "editorHasDocumentFormattingProvider && editorTextFocus && !editorHasSelection && !editorReadonly && !inCompositeEditor"
      },
      {
        "command": "editor.action.formatSelection",
        "key": "shift+alt+f",
        "when": "editorHasDocumentFormattingProvider && editorHasSelection && editorTextFocus && !editorReadonly"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "build": "node scripts/build-and-package.js patch",
    "build:minor": "node scripts/build-and-package.js minor",
    "build:major": "node scripts/build-and-package.js major",
    "version:bump": "node scripts/bump-version.js"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.87.0",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "esbuild": "^0.27.2",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.15.9"
  }
}
