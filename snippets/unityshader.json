  "URP Unlit Shader": {
    "prefix": "urpunlit",
    "body": [
      "Shader \"${1:Universal Render Pipeline/Custom/Unlit}\"",
      "{",
      "\tProperties",
      "\t{",
      "\t\t_BaseMap (\"Texture\", 2D) = \"white\" {}",
      "\t\t_BaseColor (\"Color\", Color) = (1,1,1,1)",
      "\t}",
      "\tSubShader",
      "\t{",
      "\t\tTags { \"RenderType\"=\"Opaque\" \"RenderPipeline\"=\"UniversalPipeline\" }",
      "\t\tLOD 100",
      "",
      "\t\tPass",
      "\t\t{",
      "\t\t\tName \"Unlit\"",
      "\t\t\tTags { \"LightMode\"=\"UniversalForward\" }",
      "",
      "\t\t\tHLSLPROGRAM",
      "\t\t\t#pragma vertex vert",
      "\t\t\t#pragma fragment frag",
      "",
      "\t\t\t#include \"Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl\"",
      "",
      "\t\t\tstruct Attributes",
      "\t\t\t{",
      "\t\t\t\tfloat4 positionOS : POSITION;",
      "\t\t\t\tfloat2 uv : TEXCOORD0;",
      "\t\t\t};",
      "",
      "\t\t\tstruct Varyings",
      "\t\t\t{",
      "\t\t\t\tfloat2 uv : TEXCOORD0;",
      "\t\t\t\tfloat4 positionCS : SV_POSITION;",
      "\t\t\t};",
      "",
      "\t\t\tTEXTURE2D(_BaseMap);",
      "\t\t\tSAMPLER(sampler_BaseMap);",
      "",
      "\t\t\tCBUFFER_START(UnityPerMaterial)",
      "\t\t\t\tfloat4 _BaseMap_ST;",
      "\t\t\t\thalf4 _BaseColor;",
      "\t\t\tCBUFFER_END",
      "",
      "\t\t\tVaryings vert (Attributes input)",
      "\t\t\t{",
      "\t\t\t\tVaryings output;",
      "\t\t\t\toutput.positionCS = TransformObjectToHClip(input.positionOS.xyz);",
      "\t\t\t\toutput.uv = TRANSFORM_TEX(input.uv, _BaseMap);",
      "\t\t\t\treturn output;",
      "\t\t\t}",
      "",
      "\t\t\thalf4 frag (Varyings input) : SV_Target",
      "\t\t\t{",
      "\t\t\t\thalf4 col = SAMPLE_TEXTURE2D(_BaseMap, sampler_BaseMap, input.uv) * _BaseColor;",
      "\t\t\t\treturn col;",
      "\t\t\t}",
      "\t\t\tENDHLSL",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "URP Unlit Shader 模板"
  },
  "URP Lit Shader": {
    "prefix": "urplit",
    "body": [
      "Shader \"${1:Universal Render Pipeline/Custom/Lit}\"",
      "{",
      "\tProperties",
      "\t{",
      "\t\t_BaseMap (\"Albedo\", 2D) = \"white\" {}",
      "\t\t_BaseColor (\"Color\", Color) = (1,1,1,1)",
      "\t\t_Smoothness (\"Smoothness\", Range(0,1)) = 0.5",
      "\t\t_Metallic (\"Metallic\", Range(0,1)) = 0.0",
      "\t}",
      "\tSubShader",
      "\t{",
      "\t\tTags { \"RenderType\"=\"Opaque\" \"RenderPipeline\"=\"UniversalPipeline\" }",
      "\t\tLOD 300",
      "",
      "\t\tPass",
      "\t\t{",
      "\t\t\tName \"ForwardLit\"",
      "\t\t\tTags { \"LightMode\"=\"UniversalForward\" }",
      "",
      "\t\t\tHLSLPROGRAM",
      "\t\t\t#pragma vertex vert",
      "\t\t\t#pragma fragment frag",
      "\t\t\t#pragma multi_compile _ _MAIN_LIGHT_SHADOWS",
      "\t\t\t#pragma multi_compile _ _ADDITIONAL_LIGHTS",
      "",
      "\t\t\t#include \"Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl\"",
      "\t\t\t#include \"Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl\"",
      "",
      "\t\t\tstruct Attributes",
      "\t\t\t{",
      "\t\t\t\tfloat4 positionOS : POSITION;",
      "\t\t\t\tfloat3 normalOS : NORMAL;",
      "\t\t\t\tfloat2 uv : TEXCOORD0;",
      "\t\t\t};",
      "",
      "\t\t\tstruct Varyings",
      "\t\t\t{",
      "\t\t\t\tfloat2 uv : TEXCOORD0;",
      "\t\t\t\tfloat3 normalWS : TEXCOORD1;",
      "\t\t\t\tfloat3 positionWS : TEXCOORD2;",
      "\t\t\t\tfloat4 positionCS : SV_POSITION;",
      "\t\t\t};",
      "",
      "\t\t\tTEXTURE2D(_BaseMap);",
      "\t\t\tSAMPLER(sampler_BaseMap);",
      "",
      "\t\t\tCBUFFER_START(UnityPerMaterial)",
      "\t\t\t\tfloat4 _BaseMap_ST;",
      "\t\t\t\thalf4 _BaseColor;",
      "\t\t\t\thalf _Smoothness;",
      "\t\t\t\thalf _Metallic;",
      "\t\t\tCBUFFER_END",
      "",
      "\t\t\tVaryings vert (Attributes input)",
      "\t\t\t{",
      "\t\t\t\tVaryings output;",
      "\t\t\t\toutput.positionWS = TransformObjectToWorld(input.positionOS.xyz);",
      "\t\t\t\toutput.positionCS = TransformWorldToHClip(output.positionWS);",
      "\t\t\t\toutput.normalWS = TransformObjectToWorldNormal(input.normalOS);",
      "\t\t\t\toutput.uv = TRANSFORM_TEX(input.uv, _BaseMap);",
      "\t\t\t\treturn output;",
      "\t\t\t}",
      "",
      "\t\t\thalf4 frag (Varyings input) : SV_Target",
      "\t\t\t{",
      "\t\t\t\thalf4 baseColor = SAMPLE_TEXTURE2D(_BaseMap, sampler_BaseMap, input.uv) * _BaseColor;",
      "\t\t\t\t",
      "\t\t\t\tLight mainLight = GetMainLight();",
      "\t\t\t\thalf3 normalWS = normalize(input.normalWS);",
      "\t\t\t\thalf NdotL = saturate(dot(normalWS, mainLight.direction));",
      "\t\t\t\t",
      "\t\t\t\thalf3 diffuse = baseColor.rgb * mainLight.color * NdotL;",
      "\t\t\t\thalf3 ambient = SampleSH(normalWS) * baseColor.rgb;",
      "\t\t\t\t",
      "\t\t\t\treturn half4(diffuse + ambient, baseColor.a);",
      "\t\t\t}",
      "\t\t\tENDHLSL",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "URP Lit Shader 模板"
  },
  "Shadow Caster Pass": {
    "prefix": "shadowcaster",
    "body": [
      "Pass",
      "{",
      "\tName \"ShadowCaster\"",
      "\tTags { \"LightMode\"=\"ShadowCaster\" }",
      "",
      "\tZWrite On",
      "\tZTest LEqual",
      "\tColorMask 0",
      "\tCull Back",
      "",
      "\tCGPROGRAM",
      "\t#pragma vertex vert",
      "\t#pragma fragment frag",
      "\t#pragma multi_compile_shadowcaster",
      "",
      "\t#include \"UnityCG.cginc\"",
      "",
      "\tstruct v2f",
      "\t{",
      "\t\tV2F_SHADOW_CASTER;",
      "\t};",
      "",
      "\tv2f vert (appdata_base v)",
      "\t{",
      "\t\tv2f o;",
      "\t\tTRANSFER_SHADOW_CASTER_NORMALOFFSET(o)",
