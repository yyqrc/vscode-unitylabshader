{
  "Unity Shader Template": {
    "prefix": "shader",
    "body": [
      "Shader \"${1:Custom/MyShader}\"",
      "{",
      "\tProperties",
      "\t{",
      "\t\t_MainTex (\"Texture\", 2D) = \"white\" {}",
      "\t\t_Color (\"Color\", Color) = (1,1,1,1)",
      "\t}",
      "\tSubShader",
      "\t{",
      "\t\tTags { \"RenderType\"=\"Opaque\" }",
      "\t\tLOD 100",
      "",
      "\t\tPass",
      "\t\t{",
      "\t\t\tCGPROGRAM",
      "\t\t\t#pragma vertex vert",
      "\t\t\t#pragma fragment frag",
      "\t\t\t#include \"UnityCG.cginc\"",
      "",
      "\t\t\tstruct appdata",
      "\t\t\t{",
      "\t\t\t\tfloat4 vertex : POSITION;",
      "\t\t\t\tfloat2 uv : TEXCOORD0;",
      "\t\t\t};",
      "",
      "\t\t\tstruct v2f",
      "\t\t\t{",
      "\t\t\t\tfloat2 uv : TEXCOORD0;",
      "\t\t\t\tfloat4 vertex : SV_POSITION;",
      "\t\t\t};",
      "",
      "\t\t\tsampler2D _MainTex;",
      "\t\t\tfloat4 _MainTex_ST;",
      "\t\t\tfixed4 _Color;",
      "",
      "\t\t\tv2f vert (appdata v)",
      "\t\t\t{",
      "\t\t\t\tv2f o;",
      "\t\t\t\to.vertex = UnityObjectToClipPos(v.vertex);",
      "\t\t\t\to.uv = TRANSFORM_TEX(v.uv, _MainTex);",
      "\t\t\t\treturn o;",
      "\t\t\t}",
      "",
      "\t\t\tfixed4 frag (v2f i) : SV_Target",
      "\t\t\t{",
      "\t\t\t\tfixed4 col = tex2D(_MainTex, i.uv) * _Color;",
      "\t\t\t\treturn col;",
      "\t\t\t}",
      "\t\t\tENDCG",
      "\t\t}",
      "\t}",
      "\tFallBack \"Diffuse\"",
      "}"
    ],
    "description": "基础 Unity Shader 模板"
  },
  "Surface Shader Template": {
    "prefix": "surfshader",
    "body": [
      "Shader \"${1:Custom/SurfaceShader}\"",
      "{",
      "\tProperties",
      "\t{",
      "\t\t_Color (\"Color\", Color) = (1,1,1,1)",
      "\t\t_MainTex (\"Albedo (RGB)\", 2D) = \"white\" {}",
      "\t\t_Glossiness (\"Smoothness\", Range(0,1)) = 0.5",
      "\t\t_Metallic (\"Metallic\", Range(0,1)) = 0.0",
      "\t}",
      "\tSubShader",
      "\t{",
      "\t\tTags { \"RenderType\"=\"Opaque\" }",
      "\t\tLOD 200",
      "",
      "\t\tCGPROGRAM",
      "\t\t#pragma surface surf Standard fullforwardshadows",
      "\t\t#pragma target 3.0",
      "",
      "\t\tsampler2D _MainTex;",
      "",
      "\t\tstruct Input",
      "\t\t{",
      "\t\t\tfloat2 uv_MainTex;",
      "\t\t};",
      "",
      "\t\thalf _Glossiness;",
      "\t\thalf _Metallic;",
      "\t\tfixed4 _Color;",
      "",
      "\t\tvoid surf (Input IN, inout SurfaceOutputStandard o)",
      "\t\t{",
      "\t\t\tfixed4 c = tex2D (_MainTex, IN.uv_MainTex) * _Color;",
      "\t\t\to.Albedo = c.rgb;",
      "\t\t\to.Metallic = _Metallic;",
      "\t\t\to.Smoothness = _Glossiness;",
      "\t\t\to.Alpha = c.a;",
      "\t\t}",
      "\t\tENDCG",
      "\t}",
      "\tFallBack \"Diffuse\"",
      "}"
    ],
    "description": "Unity Surface Shader 模板"
  },
  "Unlit Shader Template": {
    "prefix": "unlitshader",
    "body": [
      "Shader \"${1:Unlit/MyShader}\"",
      "{",
      "\tProperties",
      "\t{",
      "\t\t_MainTex (\"Texture\", 2D) = \"white\" {}",
      "\t}",
      "\tSubShader",
      "\t{",
      "\t\tTags { \"RenderType\"=\"Opaque\" }",
      "\t\tLOD 100",
      "",
      "\t\tPass",
      "\t\t{",
      "\t\t\tCGPROGRAM",
      "\t\t\t#pragma vertex vert",
      "\t\t\t#pragma fragment frag",
      "\t\t\t#pragma multi_compile_fog",
      "",
      "\t\t\t#include \"UnityCG.cginc\"",
      "",
      "\t\t\tstruct appdata",
      "\t\t\t{",
      "\t\t\t\tfloat4 vertex : POSITION;",
      "\t\t\t\tfloat2 uv : TEXCOORD0;",
      "\t\t\t};",
      "",
      "\t\t\tstruct v2f",
      "\t\t\t{",
      "\t\t\t\tfloat2 uv : TEXCOORD0;",
      "\t\t\t\tUNITY_FOG_COORDS(1)",
      "\t\t\t\tfloat4 vertex : SV_POSITION;",
      "\t\t\t};",
      "",
      "\t\t\tsampler2D _MainTex;",
      "\t\t\tfloat4 _MainTex_ST;",
      "",
      "\t\t\tv2f vert (appdata v)",
      "\t\t\t{",
      "\t\t\t\tv2f o;",
      "\t\t\t\to.vertex = UnityObjectToClipPos(v.vertex);",
      "\t\t\t\to.uv = TRANSFORM_TEX(v.uv, _MainTex);",
      "\t\t\t\tUNITY_TRANSFER_FOG(o,o.vertex);",
      "\t\t\t\treturn o;",
      "\t\t\t}",
      "",
      "\t\t\tfixed4 frag (v2f i) : SV_Target",
      "\t\t\t{",
      "\t\t\t\tfixed4 col = tex2D(_MainTex, i.uv);",
      "\t\t\t\tUNITY_APPLY_FOG(i.fogCoord, col);",
      "\t\t\t\treturn col;",
      "\t\t\t}",
      "\t\t\tENDCG",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "Unity Unlit Shader 模板"
  },
