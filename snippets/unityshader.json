  "HLSLPROGRAM Block": {
    "prefix": "hlslprogram",
    "body": [
      "HLSLPROGRAM",
      "#pragma vertex vert",
      "#pragma fragment frag",
      "",
      "struct Attributes",
      "{",
      "\tfloat4 positionOS : POSITION;",
      "\tfloat2 uv : TEXCOORD0;",
      "};",
      "",
      "struct Varyings",
      "{",
      "\tfloat2 uv : TEXCOORD0;",
      "\tfloat4 positionCS : SV_POSITION;",
      "};",
      "",
      "Varyings vert (Attributes input)",
      "{",
      "\tVaryings output;",
      "\toutput.positionCS = TransformObjectToHClip(input.positionOS.xyz);",
      "\toutput.uv = input.uv;",
      "\treturn output;",
      "}",
      "",
      "half4 frag (Varyings input) : SV_Target",
      "{",
      "\t$0",
      "\treturn half4(1,1,1,1);",
      "}",
      "ENDHLSL"
    ],
    "description": "HLSLPROGRAM 代码块 (URP 风格)"
  },
