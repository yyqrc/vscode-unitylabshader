    '# ifndef STDGPUSKIN_CGINC\r\n#define STDGPUSKIN_CGINC\r\n\r\n#define USE_4DUV   1\r\n#if defined(SHADERLOD_700) || defined(SHADERLOD_500)\r\n#define USE_4BONES 1\r\n#else\r\n#define USE_4BONES 0\r\n#endif\r\n\r\n\r\n#if USE_4DUV\r\n#define DECL_GPUSKIN_OUTPUT \\\r\n        half4 vertexColor;\\\r\n        float4 uv2;\\\r\n\t    half4 uv3;\r\n        \r\n#define DECL_GPUSKIN_ATTR \\\r\n        half4 vertexColor : COLOR;\\\r\n        float4 uv2 : TEXCOORD2;\\\r\n        half4  uv3 : TEXCOORD3;\r\n#define GPUSKIN_BONEWEIGHTS(v) v.uv2\r\n#define GPU…);\\\r\n        \\\r\n        wsNormal = mul(mat0, float4(localNormal, 0.0)) * wt0 + mul(mat1, float4(localNormal, 0.0)) * wt1;\\\r\n        localNormal = normalize(mul((float3x3)unity_WorldToObject, wsNormal));\\\r\n        \\\r\n        float4 transformedTangent = mul(mat0, localTangent) * wt0 + mul(mat1, localTangent) * wt1;\\\r\n        wsTangent = transformedTangent.xyz;\\\r\n        localTangent = normalize(mul(unity_WorldToObject, transformedTangent));\\\r\n\r\n\r\n#endif\r\n\r\n#endif\r\n\r\n#endif /* STDGPUSKIN_CGINC */'
